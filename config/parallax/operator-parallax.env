# PRSM operator — Parallax verifiable-inference env block (sprint 1028).
#
# Source this before `prsm node start` so the daemon joins the §7 verifiable-
# inference DHT-backed GPU pool and serves /compute/inference with signed receipts:
#
#   set -a && . config/parallax/operator-parallax.env && set +a
#
# Then supply the node-specific + deployment-path vars INLINE on the start line:
#   PRSM_ADVERTISE_ADDRESS=<public-ipv4>:9001
#   PRSM_PARALLAX_MODEL_CATALOG_FILE=$PWD/config/parallax/model_catalog.json
#   PRSM_MODEL_REGISTRY_ROOT=$HOME/.prsm/registry
#
# To FORCE a 2-stage cross-host split of gpt2 (12 layers) across >=2 big GPUs
# (demo/test — real heterogeneous fleets let the allocator decide), also set inline:
#   PRSM_PARALLAX_LAYER_CAPACITY_OVERRIDE=6   (6 layers/node x 2 nodes = 12)
#   PRSM_PARALLAX_MEMORY_GB_OVERRIDE=0.8      (so a 24GB A10 can't pack all 12)
#
# Every name + value below was verified against prsm/node/inference_wiring.py,
# prsm/node/dht_backed_pool_provider.py, and prsm/node/chain_executor_adapters.py.

# WebSocket transport — the default libp2p backend lacks the sp1023/24/25 hardening.
export PRSM_TRANSPORT_BACKEND=websocket

# Verifiable-inference executor + DHT-backed GPU pool + production trust stack.
export PRSM_INFERENCE_EXECUTOR=parallax
export PRSM_PARALLAX_GPU_POOL_KIND=dht-backed
export PRSM_PARALLAX_TRUST_STACK_KIND=production

# On-chain wiring (Base mainnet). The anchor is the hard pool-membership gate:
# each node's pubkey must be register_self'd here or its GPU is filtered out.
export PRSM_PUBLISHER_KEY_ANCHOR_ADDRESS=0xd811ad9986f44f404b0fd992168a7cc76206df03
# sp1300 — F-activation cutover: the StakeBond is now the TEE Tier-3 roadmap-F bundle
# (was 0xD4C6584B…79Ed, retired with 0 stake). Matches prsm/config/networks.py MAINNET.
export PRSM_STAKE_BOND_ADDRESS=0x21B5de0f65B9273A715C6a02b7085a8ABE8adA72

# RPC chain executor + real HuggingFace layer-slice stage server.
export PRSM_PARALLAX_CHAIN_EXECUTOR_KIND=rpc
export PRSM_PARALLAX_STAGE_EXECUTOR_KIND=layer_stage
export PRSM_PARALLAX_LAYER_SLICE_RUNNER_KIND=huggingface
export PRSM_PARALLAX_HF_MODEL_ID=gpt2
export PRSM_PARALLAX_HF_DEVICE=cuda

# Real tokenizers on the rpc path (utf8 fallback otherwise).
export PRSM_PARALLAX_PROMPT_ENCODER_KIND=huggingface
export PRSM_PARALLAX_OUTPUT_DECODER_KIND=huggingface

# Real autoregressive streaming + KV cache (only used by /compute/inference/stream).
export PRSM_PARALLAX_STREAMING_RUNNER_KIND=embedder_backed
export PRSM_PARALLAX_KV_CACHE_ENABLED=1

# Pre-stake / software-TEE live-attest posture. advisory bypasses the stake + tier
# gates; the on-chain pubkey anchor above remains the hard gate. Flip to enforced
# only once each node has a real on-chain stake bond + operator delegation.
export PRSM_PARALLAX_STAKE_ELIGIBILITY=advisory
export PRSM_PARALLAX_TIER_GATE=advisory

# Routing DP needs a finite RTT once >1 GPU is in the pool (sprint 695 F44).
export PRSM_PARALLAX_DEFAULT_RTT_MS=100

# Generous timeout for cold gpt2 load + cross-host stage roundtrip.
export PRSM_PARALLAX_SEND_MESSAGE_TIMEOUT_S=600
